{"code":"-- Patchy repaint of the dry (rusty) biome so it is not one flat brown. Roads/streets are skipped. Args: JSON with street polylines.\nlocal D = game:GetService(\"HttpService\"):JSONDecode([==[{\"streets\": [{\"w\": 7, \"pts\": [[1032.0, 986.0, 14.0], [1043.2, 993.1, 14.0], [1059.3, 1003.3, 14.0], [1077.5, 1014.6, 14.0], [1095.0, 1025.0, 14.0], [1111.7, 1033.9, 14.0], [1128.8, 1042.4, 14.0], [1145.8, 1050.9, 14.0], [1162.0, 1060.0, 14.0], [1177.2, 1069.9, 14.0], [1191.8, 1080.2, 14.0], [1206.0, 1090.7, 14.0], [1220.0, 1101.0, 14.0], [1233.9, 1111.1, 14.0], [1247.5, 1121.1, 14.0], [1260.9, 1131.1, 14.0], [1274.0, 1141.0, 14.0], [1292.8, 1155.5, 14.0], [1311.2, 1169.9, 14.0], [1324, 1180, 14.0]]}, {\"w\": 5, \"pts\": [[1214.0, 1110.0, 14.0], [1207.9, 1124.1, 14.0], [1199.2, 1144.3, 14.0], [1190.0, 1165.0, 14.0], [1183.1, 1180.0, 14.0], [1175.9, 1195.6, 14.0], [1168.7, 1210.9, 14.0], [1162.0, 1225.0, 14.0], [1153.4, 1242.8, 14.0], [1145.5, 1258.9, 14.0], [1140, 1270, 14.0]]}, {\"w\": 5, \"pts\": [[1228.0, 1092.0, 14.0], [1238.7, 1080.0, 14.0], [1254.0, 1062.8, 14.0], [1270.0, 1046.0, 14.0], [1282.0, 1034.7, 14.0], [1294.9, 1023.4, 14.0], [1307.3, 1012.6, 14.0], [1318.0, 1003.0, 14.0], [1335.0, 986.3, 14.0], [1346, 975, 14.0]]}, {\"w\": 32, \"pts\": [[1220, 1101, 14.0], [1220.0, 1101, 14.0]]}, {\"w\": 28, \"pts\": [[1310, 1170, 14.0], [1310.0, 1170, 14.0]]}, {\"w\": 8, \"pts\": [[6.0, 480.0, 6.01], [20.4, 484.5, 6.06], [38.8, 490.1, 6.12], [60.4, 496.5, 6.19], [84.8, 503.8, 6.26], [111.1, 511.9, 6.35], [138.8, 520.6, 6.43], [167.2, 529.8, 6.52], [195.6, 539.5, 6.6], [223.4, 549.6, 6.68], [250.0, 560.0, 6.74], [271.6, 569.1, 6.79], [293.6, 578.7, 6.83], [315.9, 588.8, 6.87], [338.4, 599.3, 6.9], [361.2, 610.1, 6.94], [384.0, 621.2, 6.97], [406.9, 632.6, 7.0], [429.8, 644.1, 7.04], [452.6, 655.6, 7.08], [475.3, 667.2, 7.12], [497.8, 678.7, 7.17], [520.0, 690.0, 7.23], [542.3, 701.4, 7.29], [565.0, 713.2, 7.35], [587.8, 725.2, 7.41], [610.7, 737.4, 7.48], [633.6, 749.6, 7.55], [656.2, 761.9, 7.62], [678.6, 774.0, 7.7], [700.4, 785.9, 7.78], [721.6, 797.6, 7.87], [742.0, 808.9, 7.97], [761.5, 819.7, 8.08], [780.0, 830.0, 8.2], [806.2, 844.8, 8.39], [830.9, 859.3, 8.61], [854.3, 873.2, 8.85], [876.2, 886.4, 9.11], [896.8, 898.8, 9.37], [915.9, 910.3, 9.63], [933.7, 920.7, 9.9], [950.0, 930.0, 10.16], [985.1, 948.0, 10.86], [1010.2, 959.2, 11.58], [1030.0, 968.0, 12.26], [1062, 985, 14.0]]}, {\"w\": 6, \"pts\": [[1380.0, 920.0, 13.96], [1385.7, 907.1, 14.5], [1392.8, 891.3, 15.21], [1401.1, 873.1, 16.07], [1410.4, 852.8, 17.03], [1420.5, 830.6, 18.08], [1431.3, 806.8, 19.18], [1442.5, 781.9, 20.3], [1454.1, 756.0, 21.43], [1465.7, 729.6, 22.52], [1477.4, 702.9, 23.56], [1488.8, 676.3, 24.5], [1499.8, 650.1, 25.34], [1510.3, 624.5, 26.02], [1520.0, 600.0, 26.54], [1528.8, 577.5, 26.87], [1537.8, 554.8, 27.11], [1546.9, 531.9, 27.26], [1556.0, 508.8, 27.33], [1565.2, 485.6, 27.33], [1574.2, 462.2, 27.27], [1583.1, 438.7, 27.16], [1591.8, 415.1, 27.0], [1600.2, 391.4, 26.82], [1608.1, 367.8, 26.62], [1615.7, 344.1, 26.41], [1622.7, 320.5, 26.2], [1629.2, 296.9, 25.99], [1634.9, 273.4, 25.81], [1640.0, 250.0, 25.65], [1644.7, 224.8, 25.48], [1648.8, 199.4, 25.25], [1652.3, 173.7, 24.99], [1655.3, 148.0, 24.7], [1657.8, 122.1, 24.39], [1659.8, 96.3, 24.07], [1661.2, 70.6, 23.75], [1662.3, 45.1, 23.45], [1662.9, 19.8, 23.16], [1663.0, -5.1, 22.91], [1662.8, -29.6, 22.7], [1662.2, -53.7, 22.53], [1661.3, -77.2, 22.43], [1660.0, -100.0, 22.4], [1657.7, -128.5, 22.45], [1654.4, -156.6, 22.56], [1650.4, -184.3, 22.74], [1645.5, -211.5, 22.97], [1640.1, -238.1, 23.26], [1634.1, -264.0, 23.6], [1627.8, -289.1, 23.98], [1621.1, -313.3, 24.41], [1614.1, -336.6, 24.87], [1607.1, -358.9, 25.36], [1600.0, -380.0, 25.88], [1589.2, -407.8, 26.74], [1576.5, -434.6, 27.81], [1562.8, -460.0, 28.99], [1548.8, -483.5, 30.23], [1535.2, -504.8, 31.44], [1522.9, -523.6, 32.54], [1512.6, -539.5, 33.47], [1505, -552, 34.14]]}]}]==])\nlocal T = workspace.Terrain\nlocal M = Enum.Material\nlocal CELL = 12\nlocal X0, X1, Z0, Z1 = 700, 1860, 560, 1570\nlocal rp = RaycastParams.new()\nrp.FilterType = Enum.RaycastFilterType.Include\nrp.FilterDescendantsInstances = { T }\nlocal function ground(x, z) local r = workspace:Raycast(Vector3.new(x, 600, z), Vector3.new(0, -1200, 0), rp) return r and r.Position.Y, r and r.Material end\n-- road distance\nlocal segs = {}\nfor _, s in ipairs(D.streets) do\n  for i = 1, #s.pts - 1 do\n    local a, b = s.pts[i], s.pts[i + 1]\n    table.insert(segs, { a[1], a[2], b[1], b[2], s.w })\n  end\nend\nlocal function nearRoad(x, z)\n  for _, s in ipairs(segs) do\n    local vx, vz = s[3] - s[1], s[4] - s[2]\n    local L2 = vx * vx + vz * vz\n    local t = 0\n    if L2 \u003e 0 then t = math.clamp(((x - s[1]) * vx + (z - s[2]) * vz) / L2, 0, 1) end\n    local px, pz = s[1] + vx * t, s[2] + vz * t\n    local d = math.sqrt((x - px) ^ 2 + (z - pz) ^ 2)\n    if d \u003c math.max(s[5], 4) + 10 then return true end\n  end\n  return false\nend\nlocal counts = { Sandstone = 0, Sand = 0, Grass = 0, Mud = 0, Rock = 0, skippedRoad = 0, skippedOther = 0 }\nlocal n = 0\nfor x = X0, X1 - CELL, CELL do\n  for z = Z0, Z1 - CELL, CELL do\n    local cx, cz = x + CELL / 2, z + CELL / 2\n    local gy, gm = ground(cx, cz)\n    if gm == M.Ground then\n      if nearRoad(cx, cz) then\n        counts.skippedRoad += 1\n      else\n        local n1 = math.noise(cx / 110, cz / 110, 4.1)          -- big patches\n        local n2 = math.noise(cx / 38, cz / 38, 9.7)             -- small breakup\n        local n3 = math.noise(cx / 210, cz / 210, 1.3)           -- regions\n        local to\n        if n1 \u003e 0.22 + 0.15 * n2 then to = M.Sandstone\n        elseif n1 \u003c -0.28 + 0.12 * n2 then to = M.Sand\n        elseif n3 \u003e 0.2 and n2 \u003e 0.12 then to = M.Grass\n        elseif n3 \u003c -0.25 and n2 \u003c -0.2 then to = M.Mud\n        elseif n2 \u003e 0.42 then to = M.Rock end\n        if to then\n          local reg = Region3.new(Vector3.new(x, gy - 10, z), Vector3.new(x + CELL, gy + 4, z + CELL)):ExpandToGrid(4)\n          T:ReplaceMaterial(reg, 4, M.Ground, to)\n          counts[to.Name] += 1\n        end\n      end\n    else\n      counts.skippedOther += 1\n    end\n    n += 1\n    if n % 400 == 0 then task.wait() end\n  end\nend\nlocal parts = {}\nfor k, v in pairs(counts) do table.insert(parts, k .. \"=\" .. v) end\ntable.sort(parts)\nreturn \"rusty biome repaint: \" .. table.concat(parts, \" \")\n"}